[Unit]
Description=Checkpoint API - Go REST API
After=checkpoint-keydb.service
Requires=checkpoint-keydb.service

[Container]
Image=localhost/checkpoint-api:latest
ContainerName=checkpoint-api
Network=checkpoint.network
Environment=PORT=8080
Environment=KEYDB_HOST=checkpoint-keydb
Environment=KEYDB_PORT=6379
Environment=GIN_MODE=release
EnvironmentFile=%E/border_posts_ext/.env
HealthCmd=wget --quiet --tries=1 -O /dev/null http://localhost:8080/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=40s
PodmanArgs=--memory=64m --cpus=0.3
LogDriver=json-file
LogOpt=max-size=2m
LogOpt=max-file=2

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
